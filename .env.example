AUTH_SECRET=replace-with-a-long-random-string
REPOSITORY_DRIVER=dynamo
APP_URL=http://localhost:3000

# DynamoDB — credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are picked
# up by the AWS SDK's own default chain, not read through this app's own env
# validation. DYNAMO_TABLE_PREFIX scopes table names per environment so
# dev/staging/prod can share one AWS account (e.g. "rc-portal-dev").
AWS_REGION=eu-west-2
DYNAMO_TABLE_PREFIX=rc-portal-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Phase 4b
# PAYMENT_DRIVER=mock is only allowed outside production (dev/test) — see env.ts.
PAYMENT_DRIVER=bank
STORAGE_DRIVER=local
EMAIL_DRIVER=console

# Only read when STORAGE_DRIVER=s3 (AWS S3, or any S3-compatible endpoint such as Cloudflare R2 via S3_ENDPOINT).
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Only read when EMAIL_DRIVER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Royal Creative <no-reply@royalcreative.co>
